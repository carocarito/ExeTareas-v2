# Solo úsalo cuando se cree el proyecto en Supabase. Nunca publiques este archivo con datos reales.
# Copia la URI PostgreSQL de Supabase: Connect > Session pooler (no la Project URL https).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-privada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-app.onrender.com
